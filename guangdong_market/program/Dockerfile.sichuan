FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 PORT=8501
WORKDIR /opt/sichuan
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-runtime.txt .
RUN python -m pip install --no-cache-dir -r requirements-runtime.txt && python -m pip check
COPY app/四川.py app/market_rule_profile.py app/sichuan_v5_*.py ./app/
COPY data/case39/buses.csv data/case39/branches.csv ./data/case39/
COPY scripts/launch_sichuan.py scripts/host_sichuan.py ./scripts/
RUN mkdir runs_sichuan_v5_consultation && chown 10001:10001 runs_sichuan_v5_consultation
USER 10001:10001
RUN python scripts/host_sichuan.py --check
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD ["python","-c","import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ['PORT']+'/_stcore/health',timeout=3).close()"]
CMD ["python","scripts/host_sichuan.py","--container"]
